{
  "name": "discord-bot-template",
  "version": "1.0.0",
  "type": "module",
  "description": "Discord bot template for private servers",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "start": "pm2 start ecosystem.config.cjs"
  },
  "keywords": [
    "discord",
    "bot",
    "template",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.28.0",
    "dotenv": "^16.4.5",
    "mongoose": "^8.24.8",
    "pm2": "^7.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}