{
  "name": "discord-bot-template",
  "version": "1.0.0",
  "type": "module",
  "description": "Discord bot template for private servers",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsup",
    "start": "NODE_ENV=production pm2 start ecosystem.config.cjs"
  },
  "keywords": [
    "discord",
    "bot",
    "template",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "mongoose": "^8.8.3",
    "pm2": "^5.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}